# Headless widget test: tap the checkbox, drag the slider, save the screen. From this
# directory:
#   PRISM_SCREENSHOT=/tmp/widgets.png renode --disable-gui --console widgets.resc
# Expected: "enabled" checked, volume well above its default.
$bin ?= @../../../build-local/stm32f746g_disco_renode.elf

mach create "f746"
machine LoadPlatformDescription @stm32f746g_disco.repl
sysbus LoadELF $bin

emulation RunFor "00:00:03"
sysbus.i2c3.touchscreen MoveTo 80 100
sysbus.i2c3.touchscreen Press
emulation RunFor "00:00:00.3"
sysbus.i2c3.touchscreen Release
emulation RunFor "00:00:00.5"
sysbus.i2c3.touchscreen MoveTo 240 162
sysbus.i2c3.touchscreen Press
emulation RunFor "00:00:00.2"
sysbus.i2c3.touchscreen MoveTo 300 162
emulation RunFor "00:00:00.2"
sysbus.i2c3.touchscreen MoveTo 360 162
emulation RunFor "00:00:00.2"
sysbus.i2c3.touchscreen MoveTo 400 162
emulation RunFor "00:00:00.3"
sysbus.i2c3.touchscreen Release
emulation RunFor "00:00:00.5"

python "import System; p = System.Environment.GetEnvironmentVariable('PRISM_SCREENSHOT') or 'widgets.png'; System.IO.File.WriteAllBytes(p, monitor.Machine['sysbus.ltdc'].TakeScreenshot().ToPng().ToArray())"
quit
